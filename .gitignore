# Virtual environment
.venv/

# Raw candle cache — NEVER committed (charter §10, build prompt §2 invariant 9).
# Default cache lives outside the repo (see engine/data.py); this guards any
# override that points inside it.
data_cache/

# Local replay journals/state — journals belong on the orphan `data` branch
# only. Rooted patterns: the committed parity/dry-run journal COPIES under
# research_outputs/ must not be swallowed.
/journal/
/state/

# Session packet zips — ferried by the operator, not committed.
research_outputs/packets/

# Python
__pycache__/
*.pyc
.pytest_cache/
