//@version=6
indicator("SS12-RangeFinder v0", shorttitle="SS RangeFinder", overlay=true,
     max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════
//  SS12-RangeFinder v0 — range lifecycle with DEVIATIONS
//
//  DISPLAY-ONLY RECONSTRUCTION. Rebuilt from the public artifacts of a
//  closed-source system (@sergio_tesla_, 2026-08-10 post + two screenshots)
//  — reconstruction, not code access; credit to the original author. This
//  instrument renders and never rules: no alerts, no signals, no security()
//  calls; chart timeframe only. Hypotheses route to APOLLO under G-7.
//
//  SEMANTICS: scripts/rangefinder_twin.py is the machine of record; this
//  port carries a DISCLOSED SIMPLIFICATION (RF-b): a SINGLE candidate
//  potential where the twin holds a candidate list — the status line's
//  POTENTIAL count therefore never exceeds 1 in v0. F-RF-5 pins these
//  input defaults to the twin's calibrated pins byte-for-byte; the
//  operator TV-eyeball is the parity fixture and it is PENDING.
//
//  CALIBRATED PINS (BTC 1D, window 2026-02-03 → 2026-08-21, 200 bars):
//    LEG_MIN 0.5 · REV_MIN 1.75 · TOUCH_EPS 0.30 · DEV_RETURN_BARS 4 ·
//    BREAK_CONFIRM_N 6 · BREAK_MARGIN 1.5 · ATR_LEN 14 (house, never swept)
//  Q-RESIDUALS of the calibration of record (score 10.7601):
//    Q1 coverage 60.0% vs band [72.6, 88.6]  — RESISTS (named suspect: the
//       seed law; potentials invalidate in trends before they can confirm)
//    Q2 bars/pivot 9.09 vs [19.95, 37.05]    — RESISTS (same suspect)
//    Q3 confirmed/100 bars 1.5 vs [0.38,1.12] — RESISTS
//    Q4 mean lifetime 45.7 vs [51, 144]      — near-miss
//    Q5 Jun–Jul downside deviation, survived — SATISFIED (the navy box at
//       the 60k lows exists on our tape: breach 06-30, confirm 07-01,
//       redraw to 57,758.6, range survives 50 more bars)
//    G1 last-range top 67,255 vs 83,000±1,500 — the reference's active
//       range predates any 200-day window; G2 low 57,758.6 vs 59,300±1,500
//       misses the band floor by 41 pts.
//  calibrated on a ~200-day window against published statistics of the
//  reference machine; full-history behaviour is not claimed.
// ═══════════════════════════════════════════════════════════════════════════

// ── pins — six inputs with evidence class + [VETO] tooltips;
//    ATR_LEN is the pinned house constant (14), never an input
ATR_LEN = 14   // house pin, never swept
legMin  = input.float(0.5,  "LEG_MIN (×ATR)",   minval = 0.0, step = 0.25,
     tooltip = "[VETO] [inferred merge law] legs shorter than LEG_MIN×ATR do not confirm a pivot; the running leg keeps extending. Default MEASURED by calibration 2026-08-22, never guessed.")
revMin  = input.float(1.75, "REV_MIN (×ATR)",   minval = 0.5, step = 0.25,
     tooltip = "[VETO] [D-R2a, observed ATR-ZigZag] a reversal ≥ REV_MIN×ATR(14) confirms a pivot at the wick extreme. Default MEASURED.")
touchEps = input.float(0.30, "TOUCH_EPS (×ATR)", minval = 0.0, step = 0.05,
     tooltip = "[VETO] [observed diamonds] a traverse touching the opposite boundary within TOUCH_EPS×ATR confirms the range. Default MEASURED.")
devRet  = input.int(4, "DEV_RETURN_BARS", minval = 1,
     tooltip = "[VETO] [his checklist, verbatim lifecycle] a body close back INSIDE within this many bars converts a pending breach into a CONFIRMED DEVIATION (range survives, boundary redrawn to the breach extreme). Default MEASURED.")
brkN    = input.int(6, "BREAK_CONFIRM_N", minval = 2,
     tooltip = "[VETO] [his checklist] this many CONSECUTIVE body closes beyond a boundary confirm the breakout — the range dies. Default MEASURED.")
brkMargin = input.float(1.5, "BREAK_MARGIN (×ATR)", minval = 0.25, step = 0.25,
     tooltip = "[VETO] [his checklist] a single body close beyond the boundary by ≥ BREAK_MARGIN×ATR also confirms the breakout. Default MEASURED.")

// ── const style literals (Style tab customizes)
color TAN    = color.new(#d2b48c, 78)
color TAN_LN = color.new(#b8860b, 35)
color NAVY   = color.new(#1a2f5a, 55)
color MIDCLR = color.new(color.orange, 20)
color MEMCLR = color.new(color.gray, 30)
color DIACLR = color.new(#20b2aa, 0)

atr = ta.atr(ATR_LEN)

// ── ZigZag state
var int   zdir   = 0
var int   extBar = na
var float extPx  = na
var float extLo  = na          // the LOW at the extreme bar [twin parity]
var float lastPivPx  = na
var int   lastPivDir = 0
var float prevPivPx  = na       // the same-side pivot before lastPiv (P0 cand.)
var int   prevPivBar = na
var int   lastPivBar = na
var int   nPivots = 0

// ── range state (ONE ACTIVE, the calibrated reading)
var float rTop = na
var float rBot = na
var string rState = "NONE"      // NONE | POTENTIAL | CONFIRMED
var string confirmSide = ""
var int   pendSide = 0          // 0 none · +1 top · −1 bottom
var int   pendOpen = na
var float pendExt  = na
var int   pendCloses = 0
var int   nConfirmed = 0
var int   nPotential = 0
var int   coveredBars = 0
var int   expansionFloorBar = -1
var float expPivHi = na        // extreme PIVOT prices since the floor —
var float expPivLo = na        // the twin's terminal test, not bar extremes
var box   rBox = na
var line  rMid = na
var int   confirmBar = na
var line  memT = na            // the most recent dead range's memory lines
var line  memB = na
var float memTopPx = na
var float memBotPx = na

// ── the sweep, bar by bar (close-of-bar semantics — a body close decides)
// warm-up parity with the twin: the running extreme tracks from bar 0
if bar_index <= ATR_LEN
    if na(extPx) or high >= extPx
        extPx := high
        extBar := bar_index
        extLo := low

if bar_index > ATR_LEN and not na(atr)
    // ZigZag — pivot bookkeeping is UNCONDITIONAL at every seal [review
    // BLOCKER: the first draft's guarded ternaries left prevPiv na forever
    // and the indicator rendered nothing]
    if zdir == 0
        // TWIN ORDER: up-entry → seal → extend
        if high - extLo >= revMin * atr and extLo <= low
            // up-entry without a seal (twin's zdir==0 up path)
            zdir := 1
            extPx := high
            extBar := bar_index
        else if extPx - low >= revMin * atr
            zdir := -1
            prevPivPx := lastPivPx
            prevPivBar := lastPivBar
            lastPivPx := extPx
            lastPivDir := 1
            lastPivBar := extBar
            nPivots += 1
            expPivHi := na(expPivHi) ? lastPivPx : math.max(expPivHi, lastPivPx)
            extPx := low
            extBar := bar_index
        else if high > extPx
            extPx := high
            extBar := bar_index
            extLo := low
    else if zdir == 1
        if high > extPx
            extPx := high
            extBar := bar_index
        else if extPx - low >= revMin * atr and (na(lastPivPx) or math.abs(extPx - lastPivPx) >= legMin * atr)
            prevPivPx := lastPivPx
            prevPivBar := lastPivBar
            lastPivPx := extPx
            lastPivDir := 1
            lastPivBar := extBar
            nPivots += 1
            expPivHi := na(expPivHi) ? lastPivPx : math.max(expPivHi, lastPivPx)
            zdir := -1
            extPx := low
            extBar := bar_index
    else
        if low < extPx
            extPx := low
            extBar := bar_index
        else if high - extPx >= revMin * atr and (na(lastPivPx) or math.abs(extPx - lastPivPx) >= legMin * atr)
            prevPivPx := lastPivPx
            prevPivBar := lastPivBar
            lastPivPx := extPx
            lastPivDir := -1
            lastPivBar := extBar
            nPivots += 1
            expPivLo := na(expPivLo) ? lastPivPx : math.min(expPivLo, lastPivPx)
            zdir := 1
            extPx := high
            extBar := bar_index

    // SEED — pivot pair (terminal P0, counter P1), only with no active range
    if rState == "NONE" and lastPivDir != 0 and not na(prevPivPx) and lastPivBar > expansionFloorBar and prevPivBar > expansionFloorBar
        // P0 (prevPiv) must be terminal among PIVOT prices since the floor
        // [twin law; the first draft tested bar extremes — review drift]
        bool bullTerm = lastPivDir == -1 and prevPivPx >= expPivHi and prevPivPx > lastPivPx
        bool bearTerm = lastPivDir == 1  and prevPivPx <= expPivLo and prevPivPx < lastPivPx
        if bullTerm
            rTop := prevPivPx
            rBot := lastPivPx
            confirmSide := "top"
            rState := "POTENTIAL"
            nPotential += 1
        else if bearTerm
            rTop := lastPivPx
            rBot := prevPivPx
            confirmSide := "bottom"
            rState := "POTENTIAL"
            nPotential += 1

    // POTENTIAL: invalidate / confirm
    if rState == "POTENTIAL"
        if close > rTop or close < rBot
            rState := "NONE"
            nPotential -= 1
        else
            float eps = touchEps * atr
            bool hitTop = confirmSide == "top" and high >= rTop - eps
            bool hitBot = confirmSide == "bottom" and low <= rBot + eps
            if hitTop or hitBot
                rState := "CONFIRMED"
                nPotential -= 1
                nConfirmed += 1
                confirmBar := bar_index
                rBox := box.new(bar_index, rTop, bar_index, rBot,
                     border_color = TAN_LN, bgcolor = TAN, extend = extend.right)
                rMid := line.new(bar_index, (rTop + rBot) / 2, bar_index + 1,
                     (rTop + rBot) / 2, color = MIDCLR, style = line.style_solid,
                     extend = extend.right, width = 2)
                label.new(bar_index, hitTop ? rTop : rBot, "◆",
                     style = hitTop ? label.style_label_down : label.style_label_up,
                     color = color.new(color.white, 100), textcolor = DIACLR)

    // ACTIVE: breach → deviation | breakout
    if rState == "CONFIRMED"
        if pendSide == 0
            if close > rTop
                pendSide := 1
                pendOpen := bar_index
                pendExt := high
                pendCloses := 1
            else if close < rBot
                pendSide := -1
                pendOpen := bar_index
                pendExt := low
                pendCloses := 1
        else
            pendExt := pendSide == 1 ? math.max(pendExt, high) : math.min(pendExt, low)
            bool beyond = pendSide == 1 ? close > rTop : close < rBot
            if beyond
                pendCloses += 1
            else
                // body close back INSIDE
                if bar_index - pendOpen <= devRet
                    // DEVIATION CONFIRMED — redraw + navy zone + diamond
                    float oldB = pendSide == 1 ? rTop : rBot
                    if pendSide == 1
                        rTop := math.max(rTop, pendExt)
                    else
                        rBot := math.min(rBot, pendExt)
                    box.new(pendOpen, pendSide == 1 ? pendExt : oldB,
                         bar_index, pendSide == 1 ? oldB : pendExt,
                         border_color = NAVY, bgcolor = NAVY)
                    label.new(bar_index, pendExt, "◆",
                         style = pendSide == 1 ? label.style_label_down : label.style_label_up,
                         color = color.new(color.white, 100), textcolor = DIACLR)
                    box.set_top(rBox, rTop)
                    box.set_bottom(rBox, rBot)
                    line.set_y1(rMid, (rTop + rBot) / 2)
                    line.set_y2(rMid, (rTop + rBot) / 2)
                pendSide := 0
                pendCloses := 0
        if pendSide != 0
            float bnd = pendSide == 1 ? rTop : rBot
            bool dieN = pendCloses >= brkN
            bool dieM = pendSide == 1 ? close - bnd >= brkMargin * atr : bnd - close >= brkMargin * atr
            if dieN or dieM
                // BREAKOUT — the range dies; memory lines; death arrow
                box.set_right(rBox, bar_index)
                box.set_extend(rBox, extend.none)
                line.set_x2(rMid, bar_index)
                line.set_extend(rMid, extend.none)
                memT := line.new(confirmBar, rTop, bar_index, rTop,
                     color = MEMCLR, style = line.style_dashed,
                     extend = extend.right)
                memB := line.new(confirmBar, rBot, bar_index, rBot,
                     color = MEMCLR, style = line.style_dashed,
                     extend = extend.right)
                memTopPx := rTop
                memBotPx := rBot
                label.new(bar_index, pendSide == 1 ? rTop : rBot,
                     pendSide == 1 ? "▲" : "▼",
                     style = pendSide == 1 ? label.style_label_up : label.style_label_down,
                     color = color.new(color.white, 100),
                     textcolor = pendSide == 1 ? color.green : color.red)
                rState := "NONE"
                pendSide := 0
                pendCloses := 0
                expansionFloorBar := bar_index
                expPivHi := na
                expPivLo := na

    // memory lines FREEZE at the first later touch [queue law]
    if not na(memT) and high >= memTopPx
        line.set_x2(memT, bar_index)
        line.set_extend(memT, extend.none)
        memT := na
    if not na(memB) and low <= memBotPx
        line.set_x2(memB, bar_index)
        line.set_extend(memB, extend.none)
        memB := na

    // coverage — live evaluation, deviation zones count as inside
    if rState == "CONFIRMED" and close <= rTop and close >= rBot
        coveredBars += 1

// ── the status table, his confession format
// DISCLOSED: every status number is FULL CHART HISTORY (from bar ~15 on);
// the twin's confession line and the Q-targets are a 200-bar window — the
// two lines will NOT match on a longer chart, by construction.
var table t = table.new(position.top_left, 1, 1, bgcolor = color.new(color.black, 25))
if barstate.islast
    float cov = bar_index > 0 ? 100.0 * coveredBars / (bar_index + 1) : 0.0
    string st = str.tostring(bar_index + 1) + " CANDLES · " +
         str.tostring(cov, "#.#") + "% RANGE COVERAGE · " +
         str.tostring(nPotential) + " POTENTIAL · " +
         str.tostring(nConfirmed) + " CONFIRMED · " +
         str.tostring(nPivots) + " SUPPORTING PIVOTS"
    table.cell(t, 0, 0, st, text_color = color.white, text_size = size.small)
