{
  "version": 4,
  "python": "C:\\venvs\\naiad\\Scripts\\python.exe",
  "slots": ["london", "ny_am", "post_ny"],
  "output_dir": "exchange/status/daily",
  "publish": true,
  "daily_archive_dir": "research_outputs/_daily_archive",
  "keep_daily": 7,
  "backup_dest": "D:\\naiad-backups",
  "reminders": {
    "estate_max_days": 8,
    "workflow_max_days": 8,
    "operator_export_max_days": 35,
    "keep_estate": 4,
    "keep_phase_sets": 1,
    "keep_workflow": 4
  },
  "jobs": [
    { "id": "manifest", "script": "scripts/reviewer_manifest.py", "required": true,
      "stage": [{ "from": "exchange/status/MANIFEST.json", "to": "MANIFEST_{date}.json" }] },
    { "id": "brief", "script": "scripts/daily_brief.py", "required": false,
      "retired": "2026-08-05",
      "retired_because": "ruling D-3: v1.1 retires once a BRIEF-2 render exists. It does. daily_brief.py is NOT deleted -- it is still imported by brief_capture.py for the Part I layers, and its published numbers are the bridge to every pre-2026-08 archive. It is no longer SCHEDULED.",
      "superseded_by": ["brief2_capture", "brief2_panel"],
      "scheduled": false,
      "stage": [],
      "reference": ["research_outputs/brief/brief_{date}.html",
                    "research_outputs/brief/brief_{date}.json"] },
    { "id": "brief2_capture", "script": "scripts/brief_capture.py",
      "required": false, "slot_aware": true,
      "stage": [],
      "reference": ["briefs/brief_{date}_{slot}.json"] },
    { "id": "brief2_panel", "script": "scripts/brief_panel.py",
      "required": false,
      "stage": [],
      "reference": ["briefs/panel/snapshots/{date}.parquet",
                    "briefs/panel/levels/{date}.parquet",
                    "briefs/panel/areas/{date}.parquet"] }
  ]
}
